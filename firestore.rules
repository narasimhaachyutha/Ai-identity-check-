rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'lakshmiarasimha544@gmail.com'
      );
    }

    function isValidVerification(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.inspectorId is string && data.inspectorId.size() <= 128 &&
             data.riskLevel is string && data.riskLevel.size() <= 32 &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('riskScore' in data) || (data.riskScore is number && data.riskScore >= 0 && data.riskScore <= 100)) &&
             (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 256)) &&
             (!('documentType' in data) || (data.documentType is string && data.documentType.size() <= 64)) &&
             (!('documentNumber' in data) || (data.documentNumber is string && data.documentNumber.size() <= 64)) &&
             (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 128)) &&
             (!('auditHash' in data) || (data.auditHash is string && data.auditHash.size() <= 128)) &&
             (!('recordJson' in data) || data.recordJson is string) &&
             (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.role is string && data.role.size() <= 32 &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('checkpointStation' in data) || (data.checkpointStation is string && data.checkpointStation.size() <= 128)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Verifications Collection: Border screening records
    match /verifications/{verificationId} {
      allow get: if isSignedIn() && (resource.data.inspectorId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.inspectorId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(verificationId) &&
                       isValidVerification(incoming()) &&
                       (incoming().inspectorId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(verificationId) &&
                       (resource.data.inspectorId == request.auth.uid || isAdmin()) &&
                       isValidVerification(incoming()) &&
                       (incoming().inspectorId == existing().inspectorId || isAdmin());
      allow delete: if isSignedIn() && isValidId(verificationId) &&
                       (resource.data.inspectorId == request.auth.uid || isAdmin());
    }

    // User Profiles Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().id == request.auth.uid &&
                       (incoming().role == 'officer' || isAdmin());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().id == existing().id &&
                       (incoming().role == existing().role || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
